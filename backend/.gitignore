# ==============================================
# .gitignore - Task Manager Backend
# ==============================================

# Dependencies
node_modules/

# Environment Variables (NEVER commit secrets)
.env
.env.local
.env.production

# Logs
logs/
*.log
npm-debug.log*

# OS Files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Build output
dist/
build/

# Coverage
coverage/
